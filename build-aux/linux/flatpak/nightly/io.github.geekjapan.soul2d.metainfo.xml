    </screenshot>
  </screenshots>
  <releases>
    <release version="nightly">
      <url>https://github.com/geekjapan/Soul2D/</url>
      <description>
         <p>This is a nightly build of Soul2D!</p>
         <p>Soul2D may crash unexpectedly and you will likely encounter bugs.</p>
         <p>Make sure to save and back up your work often!</p>
      </description>
    </release>
  </releases>
