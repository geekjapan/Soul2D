<component type="desktop">
  <id>io.github.geekjapan.soul2d</id>
  <name>Soul2D (Nightly)</name>
  <summary>Experimental 2D model editor</summary>
  <developer_name>Soul2D contributors</developer_name>
  <launchable type="desktop-id">io.github.geekjapan.soul2d.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>BSD-2-Clause</project_license>
  <description>
    <p>Soul2D is an experimental editor for 2D models that are animated in real time, for VTubing, game
      development and digital animation.</p>
    <p>It opens, edits and saves INP and INX models, and has a headless core that other programs drive.</p>
  </description>
